{
  "name": "@signalwerk/minicms-api",
  "version": "0.1.0",
  "private": true,
  "description": "Filesystem content API for miniCMS.",
  "type": "module",
  "bin": {
    "minicms-api": "./bin/minicms-api.mjs"
  },
  "scripts": {
    "dev": "node ./bin/minicms-api.mjs dev",
    "migrate:identity": "node ./bin/migrate-record-identity.mjs",
    "start": "node ./bin/minicms-api.mjs start",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@signalwerk/minicms": "https://github.com/signalwerk/miniCMS/archive/e66bb4f3642de0354353efdfa7d35ab4893e1570.tar.gz",
    "express": "^5.1.0",
    "mime-types": "^3.0.1",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=24"
  }
}
